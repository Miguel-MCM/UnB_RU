<% content_for :title, "Cardápio · RU UnB Digital" %>

<div class="gestao cardapio">
  <header class="gestao__cabecalho">
    <div>
      <p class="eyebrow">Consulte as opções servidas agora no Restaurante Universitário.</p>
      <h1 class="gestao__titulo">Cardápio da Refeição Atual</h1>
    </div>
  </header>

  <% if @current_meal_type.nil? %>
    <p class="card painel__vazio" id="no-meal-message">Não há refeição sendo servida no momento</p>
  <% elsif @menu.nil? %>
    <p class="card painel__vazio" id="unavailable-menu-message">O cardápio do <%= @meal_label %> não está disponível</p>
  <% else %>
    <% complementos = complementos_do_cardapio(@current_meal_type, @menu) %>
    <section id="active-meal-cardapio" class="cardapio__grade">
      <div class="card cardapio__principal">
        <h2 class="passo__titulo"><span class="passo__numero">1</span> Cardápio do <%= @meal_label %></h2>

        <div class="cardapio__pratos">
          <% pratos_do_cardapio(@current_meal_type, @menu).each do |selo, texto| %>
            <div class="cardapio__prato">
              <span class="selo selo--modulo"><%= selo %></span>
              <p><%= texto %></p>
            </div>
          <% end %>
        </div>

        <% if @menu.extra_option.present? %>
          <p class="cardapio__linha" id="extra-option">Opção extra: <%= @menu.extra_option %></p>
        <% end %>

        <% if complementos %>
          <h3 class="passo__titulo"><span class="passo__numero">2</span> <%= complementos.first %></h3>
          <% complementos.last.each do |linha| %>
            <p class="cardapio__linha"><%= linha %></p>
          <% end %>
        <% end %>
      </div>

      <aside class="card cardapio__resumo">
        <h3 class="gestao__subtitulo">Resumo do Turno</h3>
        <dl>
          <div><dt>Refeição:</dt><dd><%= @meal_label.capitalize %></dd></div>
          <div><dt>Data:</dt><dd><%= l(@menu.served_on, format: "%d/%m/%Y") %></dd></div>
          <div><dt>Modalidades:</dt><dd>Padrão, Ovolacto e Vegana</dd></div>
        </dl>
      </aside>
    </section>
  <% end %>
</div>
