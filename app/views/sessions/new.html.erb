<% content_for :title, "Acessar · RU UnB Digital" %>

<section class="card auth-card">
  <span class="auth-card__icon"><%= icon(:login) %></span>
  <h1 class="auth-card__title">Acesse sua conta</h1>
  <p class="auth-card__subtitle">
    O acesso com matrícula e senha ao Portal do Estudante estará disponível em breve.
  </p>

  <p class="auth-card__footer">
    <%= link_to "Ainda não possui uma conta? Cadastre-se", signup_path, class: "link" %>
  </p>
</section>
