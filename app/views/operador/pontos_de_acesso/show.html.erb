<% content_for :title, "Ponto de Acesso · RU UnB" %>

<div class="gestao">
  <header class="gestao__cabecalho">
    <div>
      <p class="selo selo--modulo">Configuração do ponto de acesso</p>
      <h1 class="gestao__titulo">Selecione o restaurante</h1>
      <p class="unidade__detalhe">Escolha o restaurante que será gerenciado neste ponto de acesso.</p>
    </div>
  </header>

  <section class="card painel">
    <h2 class="painel__titulo"><%= icon(:restaurant) %> Restaurantes disponíveis</h2>

    <% if @restaurantes.any? %>
      <ul class="catracas" id="restaurantes">
        <% @restaurantes.each do |restaurante| %>
          <li class="catraca" id="<%= dom_id(restaurante) %>">
            <div>
              <p class="catraca__nome"><%= restaurante.nome %></p>
              <% if restaurante == current_restaurante %>
                <p class="catraca__status">Selecionado</p>
              <% end %>
            </div>
            <%= button_to restaurante.nome, operador_ponto_de_acesso_path, method: :patch,
                  params: { restaurante_id: restaurante.id }, class: "button button--primary" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="painel__vazio">Nenhum restaurante cadastrado.</p>
    <% end %>
  </section>
</div>
